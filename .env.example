# Optional runtime/client data directory (contains private token and sessions)
PI_RUNTIME_HOME=/home/your-user/.local/share/pi-runtime
RUST_LOG=info
# Separate native QQ channel data directory
PI_QQ_HOME=/home/your-user/.local/share/pi-qq
# Model/provider selection is saved by `pi-runtime init --provider ... --model ...`.
# Pi API credentials remain in Pi's existing auth store, not in this project.
